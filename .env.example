# No passwords here: credentials come from AWS Secrets Manager via the EC2 instance role.
AWS_REGION=ap-south-1
DB_SECRET_ID=taskapp/rds
# Only needed if the secret JSON has no "host"/"dbname" (RDS-managed master secrets don't include them):
DB_HOST=your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_NAME=appdb
DB_SSLMODE=require
